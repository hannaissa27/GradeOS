# ── Supabase (todos storage) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI (pick ONE provider — all have a free tier) ──────────────────────────────
# Groq (recommended: fastest, ~1,000 free requests/day)  → https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (alternative)                             → https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# OpenRouter (alternative, use a ":free" model)           → https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional overrides. Defaults: groq → openai/gpt-oss-20b, gemini → gemini-2.5-flash,
# openrouter → meta-llama/llama-3.3-70b-instruct:free
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-20b
